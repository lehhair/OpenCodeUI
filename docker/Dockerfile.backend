# ============================================
# OpenCode WebUI - Backend
# ============================================
# Debian slim + opencode serve + agent tooling

FROM docker:29-cli AS docker-cli

FROM debian:bookworm-slim

ARG TARGETARCH
ARG USE_CHINA_MIRROR=0
ARG APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
ARG APT_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian-security
ARG NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
ARG NODEJS_ORG_MIRROR=https://npmmirror.com/mirrors/node
ARG MISE_INSTALL_URL=https://mise.run

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TERM=xterm-256color \
    COLORTERM=truecolor \
    EDITOR=vim \
    NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY} \
    NODEJS_ORG_MIRROR=${NODEJS_ORG_MIRROR}

RUN if [ "${USE_CHINA_MIRROR}" = "1" ] && [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i \
        -e "s|http://deb.debian.org/debian|${APT_MIRROR}|g" \
        -e "s|http://security.debian.org/debian-security|${APT_SECURITY_MIRROR}|g" \
        /etc/apt/sources.list.d/debian.sources; \
    fi

# Agent 常用基础环境。语言运行时交给 mise，安装到持久化的 /root。
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    dnsutils \
    fd-find \
    file \
    fonts-dejavu-core \
    fonts-liberation \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    g++ \
    git \
    git-lfs \
    gnupg \
    jq \
    less \
    make \
    nano \
    openssh-client \
    patch \
    procps \
    python3 \
    python3-venv \
    ripgrep \
    rsync \
    tini \
    tzdata \
    unzip \
    vim-tiny \
    wget \
    xz-utils \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Docker CLI + Compose/Buildx plugin，只复制客户端，不安装 dockerd/containerd/runc。
RUN mkdir -p /usr/local/libexec/docker/cli-plugins
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx

# Debian 的 fd 二进制叫 fdfind，补一个常见命令名。
RUN ln -sf /usr/bin/fdfind /usr/local/bin/fd

# 安装 mise。直接跑 mise.run 的安装脚本会踩两个坑：
#   1. 脚本默认装「24 小时前发布」的版本，那个版本没有内置校验和，得现去
#      GitHub Releases 拉 SHASUMS256.txt；这条链路在 Actions 上时不时 504，
#      构建就卡死在这里（2026-11-08 连续两次）。
#   2. 强制 MISE_INSTALL_FROM_GITHUB=1 又让 tarball 也走同一条不稳的路径。
# 做法：从脚本里取出它内置的当前版本号，用 MISE_VERSION 钉住这个版本。
# 这样校验和直接用脚本里写死的那份，tarball 走 mise.jdx.dev（CDN 只保留
# 当前版本，正好对得上），装的时候完全不碰 GitHub。
# arm64 的 gnu 二进制需要 GLIBC_2.38+，但 bookworm-slim 只有 2.36，故 arm64 改用静态链接的
# musl 变体（MISE_INSTALL_ARCH 覆盖脚本的 ldd 探测）。用 MISE_INSTALL_PATH 直接落位，免去 find/cp。
RUN set -eux; \
    curl -fsSL --retry 3 --retry-delay 2 --retry-connrefused -o /tmp/mise-install.sh "${MISE_INSTALL_URL}"; \
    MISE_PIN="$(sed -n 's/^[[:space:]]*current_version="v\{0,1\}\([0-9][0-9.]*\)".*$/\1/p' /tmp/mise-install.sh | head -n1)"; \
    case "${TARGETARCH}" in \
      amd64) MISE_ARCH=x64 ;; \
      arm64) MISE_ARCH=arm64-musl ;; \
      *) echo "unsupported arch: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    if [ -n "${MISE_PIN}" ]; then \
      MISE_INSTALL_PATH=/usr/local/bin/mise MISE_INSTALL_ARCH="${MISE_ARCH}" MISE_VERSION="${MISE_PIN}" sh /tmp/mise-install.sh; \
    else \
      MISE_INSTALL_PATH=/usr/local/bin/mise MISE_INSTALL_FROM_GITHUB=1 MISE_INSTALL_ARCH="${MISE_ARCH}" sh /tmp/mise-install.sh; \
    fi; \
    rm -f /tmp/mise-install.sh; \
    mise --version

# 安装并保留本次发行清单，运行时补装只使用这份清单。
COPY docker/opencode-release.sh /usr/local/lib/opencode-release.sh
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# 留空表示装清单里的最新 v2；填版本号时与清单校验，不一致直接失败。
ARG OPENCODE_VERSION=
ARG OPENCODE_MANIFEST_URL=https://opencode.ai/update/api/latest/cli/opencode
# CI 传入同一次解析的完整清单；本地构建留空时才读取 MANIFEST_URL。
ARG OPENCODE_MANIFEST_BASE64=

RUN set -eu; \
    mkdir -p /usr/local/share/opencode; \
    if [ -n "${OPENCODE_MANIFEST_BASE64}" ]; then \
      printf '%s' "${OPENCODE_MANIFEST_BASE64}" | base64 -d > /usr/local/share/opencode/release.json; \
    else \
      curl -fsSL --retry 3 --retry-delay 2 --retry-connrefused -o /usr/local/share/opencode/release.json "${OPENCODE_MANIFEST_URL}"; \
    fi; \
    . /usr/local/lib/opencode-release.sh; \
    install_opencode /usr/local/share/opencode/release.json /usr/local/bin/opencode "${TARGETARCH}" "${OPENCODE_VERSION}"

# 工作目录
RUN mkdir -p /workspace
WORKDIR /workspace

ENV MISE_DATA_DIR=/root/.local/share/mise \
    MISE_CONFIG_DIR=/root/.config/mise \
    MISE_STATE_DIR=/root/.local/state/mise \
    OPENCODE_DISABLE_AUTOUPDATE=true \
    OPENCODE_DISABLE_TERMINAL_TITLE=true \
    WORKSPACE=/workspace

ENV PATH="/root/.local/bin:/root/.cargo/bin:/root/.local/share/mise/shims:/root/.local/share/mise/bin:${PATH}"

COPY ./docker/backend-entrypoint.sh /usr/local/bin/backend-entrypoint.sh
RUN chmod +x /usr/local/bin/backend-entrypoint.sh

EXPOSE 4096

ENTRYPOINT ["tini", "--", "/usr/local/bin/backend-entrypoint.sh"]
CMD ["/usr/local/bin/opencode", "serve", "--port", "4096", "--hostname", "0.0.0.0"]
